# NĪHĀRAMESH — local development configuration
# This file contains PLACEHOLDERS ONLY. Never commit real credentials.
# The core demonstration requires NO API keys and NO cloud account.

# ---- API server ----
# Loopback by default. Binding to 0.0.0.0 requires an intentional
# authenticated configuration (see docs/SECURITY.md).
NIHARA_API_HOST=127.0.0.1
NIHARA_API_PORT=8100
# Comma-separated explicit origins, or empty for same-origin only.
NIHARA_CORS_ORIGINS=http://localhost:5173

# ---- Web dev server ----
NIHARA_WEB_PORT=5173

# ---- Runtime mode ----
# deterministic = injected logical clock, fixed-step scheduler
# processes    = real OS processes over real sockets, monotonic local timers
NIHARA_MODE=deterministic

# ---- Storage ----
NIHARA_DATA_DIR=./var/data
NIHARA_RUNS_DIR=./var/runs

# ---- Fault injection seed ----
NIHARA_FAULT_SEED=20260101

# ---- Physical actuation ----
# HARD DISABLED BY DEFAULT. Enabling requires explicit configured devices,
# a controlled test area and operator authorization. See docs/EDGE.md.
NIHARA_PHYSICAL_ACTUATION_ENABLED=false

# ---- Optional authenticated non-loopback mode (empty = disabled) ----
# NIHARA_OPERATOR_TOKEN=
