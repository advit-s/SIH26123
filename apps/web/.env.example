# NĪHĀRAMESH operator cockpit — dev server
#
# The cockpit reads the API base from here. Leave it unset to use the Vite dev
# proxy in vite.config.ts, which forwards /api to http://127.0.0.1:8100.
#
# Set it to an absolute URL when the API is NOT on this machine:
#   VITE_API_BASE=http://192.168.1.20:8100
VITE_API_BASE=http://127.0.0.1:8100