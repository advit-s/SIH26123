{
  "$defs": {
    "TimeDomain": {
      "description": "Named clock domains. Values are never mixed across domains.\n\n``LOGICAL``\n    Injected logical simulation time. Freezes when the harness pauses and\n    advances under acceleration. Used by the deterministic mode.\n``SIM_SECONDS``\n    Simulation seconds elapsed since the declared common run start. Derived\n    from ``LOGICAL``; identical semantics, different unit framing.\n``MONOTONIC``\n    The agent's own ``time.monotonic_ns()``. Never comparable across\n    processes without an explicit measured offset *and* uncertainty.\n``DISPLAY_UTC``\n    Wall-clock UTC for human display only. Never used for expiry.",
      "enum": [
        "logical",
        "sim_seconds",
        "monotonic",
        "display_utc"
      ],
      "title": "TimeDomain",
      "type": "string"
    }
  },
  "$id": "https://niharamesh.local/schemas/PeerIntent.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Predicted path and the resources the sender expects to need.\n\nAn intent is a *prediction*, never an authorization. Receiving one grants\nnothing.",
  "properties": {
    "epoch": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Epoch",
      "type": "string"
    },
    "expected_zones": {
      "default": [],
      "items": {
        "maxLength": 40,
        "minLength": 1,
        "type": "string"
      },
      "title": "Expected Zones",
      "type": "array"
    },
    "map_digest": {
      "maxLength": 64,
      "title": "Map Digest",
      "type": "string"
    },
    "map_id": {
      "maxLength": 40,
      "title": "Map Id",
      "type": "string"
    },
    "plan_version": {
      "minimum": 0,
      "title": "Plan Version",
      "type": "integer"
    },
    "projected_path": {
      "default": [],
      "items": {
        "maxItems": 3,
        "minItems": 3,
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "type": "array"
      },
      "title": "Projected Path",
      "type": "array"
    },
    "protocol_version": {
      "default": "1.0.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "robot_id": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Robot Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sent_at_ns": {
      "minimum": 0,
      "title": "Sent At Ns",
      "type": "integer"
    },
    "seq": {
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "session_id": {
      "maxLength": 40,
      "title": "Session Id",
      "type": "string"
    },
    "time_domain": {
      "$ref": "#/$defs/TimeDomain"
    },
    "validity_horizon_ns": {
      "minimum": 0,
      "title": "Validity Horizon Ns",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "epoch",
    "map_id",
    "map_digest",
    "robot_id",
    "session_id",
    "seq",
    "plan_version",
    "validity_horizon_ns",
    "sent_at_ns",
    "time_domain"
  ],
  "title": "PeerIntent",
  "type": "object",
  "x-niharamesh-version": "1.0.0"
}
