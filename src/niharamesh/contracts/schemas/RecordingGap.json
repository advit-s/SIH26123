{
  "$defs": {
    "EventCategory": {
      "enum": [
        "authority",
        "evaluation",
        "task",
        "planning",
        "safety",
        "fault",
        "command",
        "lifecycle",
        "telemetry"
      ],
      "title": "EventCategory",
      "type": "string"
    }
  },
  "$id": "https://niharamesh.local/schemas/RecordingGap.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An explicit, visible hole in durable evidence.\n\nA run with an unresolved gap in a durable category is marked incomplete and\nits affected metrics are excluded from claims requiring complete evidence.",
  "properties": {
    "category": {
      "$ref": "#/$defs/EventCategory"
    },
    "cause": {
      "maxLength": 160,
      "title": "Cause",
      "type": "string"
    },
    "from_seq": {
      "minimum": 0,
      "title": "From Seq",
      "type": "integer"
    },
    "recovered": {
      "default": false,
      "title": "Recovered",
      "type": "boolean"
    },
    "run_id": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "sim_time_from_s": {
      "title": "Sim Time From S",
      "type": "number"
    },
    "sim_time_to_s": {
      "title": "Sim Time To S",
      "type": "number"
    },
    "to_seq": {
      "minimum": 0,
      "title": "To Seq",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "category",
    "from_seq",
    "to_seq",
    "sim_time_from_s",
    "sim_time_to_s",
    "cause"
  ],
  "title": "RecordingGap",
  "type": "object",
  "x-niharamesh-version": "1.0.0"
}
