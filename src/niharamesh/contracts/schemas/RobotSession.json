{
  "$id": "https://niharamesh.local/schemas/RobotSession.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One incarnation (boot) of a robot.\n\nEvery protocol message carries the session id of its sender. A message from\na stale session is rejected, never merged into current state.",
  "properties": {
    "host": {
      "default": "localhost",
      "maxLength": 128,
      "title": "Host",
      "type": "string"
    },
    "listening_port": {
      "default": 0,
      "maximum": 65535,
      "minimum": 0,
      "title": "Listening Port",
      "type": "integer"
    },
    "pid": {
      "default": 0,
      "minimum": 0,
      "title": "Pid",
      "type": "integer"
    },
    "protocol_version": {
      "default": "1.0.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "robot_id": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Robot Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "started_at_ns": {
      "minimum": 0,
      "title": "Started At Ns",
      "type": "integer"
    }
  },
  "required": [
    "robot_id",
    "session_id",
    "started_at_ns"
  ],
  "title": "RobotSession",
  "type": "object",
  "x-niharamesh-version": "1.0.0"
}
