{
  "$defs": {
    "EventCategory": {
      "enum": [
        "authority",
        "evaluation",
        "task",
        "planning",
        "safety",
        "fault",
        "command",
        "lifecycle",
        "telemetry"
      ],
      "title": "EventCategory",
      "type": "string"
    },
    "MetricAvailability": {
      "enum": [
        "measured",
        "unavailable",
        "excluded"
      ],
      "title": "MetricAvailability",
      "type": "string"
    },
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/MetricAvailability"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "note": {
          "default": "",
          "maxLength": 200,
          "title": "Note",
          "type": "string"
        },
        "sample_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Count"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "key",
        "availability"
      ],
      "title": "MetricValue",
      "type": "object"
    },
    "RecordingGap": {
      "additionalProperties": false,
      "description": "An explicit, visible hole in durable evidence.\n\nA run with an unresolved gap in a durable category is marked incomplete and\nits affected metrics are excluded from claims requiring complete evidence.",
      "properties": {
        "category": {
          "$ref": "#/$defs/EventCategory"
        },
        "cause": {
          "maxLength": 160,
          "title": "Cause",
          "type": "string"
        },
        "from_seq": {
          "minimum": 0,
          "title": "From Seq",
          "type": "integer"
        },
        "recovered": {
          "default": false,
          "title": "Recovered",
          "type": "boolean"
        },
        "run_id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "sim_time_from_s": {
          "title": "Sim Time From S",
          "type": "number"
        },
        "sim_time_to_s": {
          "title": "Sim Time To S",
          "type": "number"
        },
        "to_seq": {
          "minimum": 0,
          "title": "To Seq",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "category",
        "from_seq",
        "to_seq",
        "sim_time_from_s",
        "sim_time_to_s",
        "cause"
      ],
      "title": "RecordingGap",
      "type": "object"
    },
    "RunOutcome": {
      "enum": [
        "success",
        "unsafe",
        "degraded",
        "expected_safe_stop",
        "failed",
        "timed_out",
        "cancelled",
        "incomplete_evidence"
      ],
      "title": "RunOutcome",
      "type": "string"
    },
    "RunState": {
      "enum": [
        "queued",
        "running",
        "paused",
        "completed",
        "unsafe",
        "failed",
        "timed_out",
        "cancelled"
      ],
      "title": "RunState",
      "type": "string"
    }
  },
  "$id": "https://niharamesh.local/schemas/RunResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The outcome of one run, always including failures and timeouts.",
  "properties": {
    "collisions": {
      "minimum": 0,
      "title": "Collisions",
      "type": "integer"
    },
    "digest": {
      "default": "",
      "maxLength": 64,
      "title": "Digest",
      "type": "string"
    },
    "events_path": {
      "default": "",
      "maxLength": 400,
      "title": "Events Path",
      "type": "string"
    },
    "gaps": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RecordingGap"
      },
      "title": "Gaps",
      "type": "array"
    },
    "makespan_s": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Makespan S"
    },
    "manifest_digest": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Manifest Digest",
      "type": "string"
    },
    "metrics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MetricValue"
      },
      "title": "Metrics",
      "type": "array"
    },
    "min_clearance_m": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Min Clearance M"
    },
    "outcome": {
      "$ref": "#/$defs/RunOutcome"
    },
    "run_id": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "sim_duration_s": {
      "minimum": 0.0,
      "title": "Sim Duration S",
      "type": "number"
    },
    "state": {
      "$ref": "#/$defs/RunState"
    },
    "stop_reason": {
      "default": "",
      "maxLength": 200,
      "title": "Stop Reason",
      "type": "string"
    },
    "tasks_completed": {
      "minimum": 0,
      "title": "Tasks Completed",
      "type": "integer"
    },
    "tasks_total": {
      "minimum": 0,
      "title": "Tasks Total",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "state",
    "outcome",
    "manifest_digest",
    "sim_duration_s",
    "tasks_total",
    "tasks_completed",
    "collisions"
  ],
  "title": "RunResult",
  "type": "object",
  "x-niharamesh-version": "1.0.0"
}
