{
  "$defs": {
    "ActuatorModel": {
      "additionalProperties": false,
      "properties": {
        "accel_mps2": {
          "default": 0.5,
          "exclusiveMinimum": 0.0,
          "maximum": 5.0,
          "title": "Accel Mps2",
          "type": "number"
        },
        "angular_accel_radps2": {
          "default": 1.5,
          "exclusiveMinimum": 0.0,
          "maximum": 10.0,
          "title": "Angular Accel Radps2",
          "type": "number"
        },
        "command_ttl_s": {
          "default": 0.4,
          "exclusiveMinimum": 0.01,
          "maximum": 10.0,
          "title": "Command Ttl S",
          "type": "number"
        },
        "decel_mps2": {
          "default": 0.8,
          "exclusiveMinimum": 0.0,
          "maximum": 10.0,
          "title": "Decel Mps2",
          "type": "number"
        },
        "max_angular_radps": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "maximum": 3.0,
          "title": "Max Angular Radps",
          "type": "number"
        },
        "max_linear_mps": {
          "default": 0.4,
          "exclusiveMinimum": 0.0,
          "maximum": 2.0,
          "title": "Max Linear Mps",
          "type": "number"
        }
      },
      "title": "ActuatorModel",
      "type": "object"
    },
    "AssignmentPolicy": {
      "enum": [
        "none",
        "local_auction"
      ],
      "title": "AssignmentPolicy",
      "type": "string"
    },
    "BatteryModel": {
      "additionalProperties": false,
      "description": "Declared battery model. UI must state ``source`` alongside any value.",
      "properties": {
        "drain_per_metre_c": {
          "default": 4e-05,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Drain Per Metre C",
          "type": "number"
        },
        "drain_per_second_idle_c": {
          "default": 8e-06,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Drain Per Second Idle C",
          "type": "number"
        },
        "service_drain_c": {
          "default": 0.0005,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Service Drain C",
          "type": "number"
        },
        "source": {
          "default": "simulated",
          "maxLength": 16,
          "title": "Source",
          "type": "string"
        },
        "start_fraction": {
          "default": 0.92,
          "maximum": 1.0,
          "minimum": 0.01,
          "title": "Start Fraction",
          "type": "number"
        }
      },
      "title": "BatteryModel",
      "type": "object"
    },
    "Berth": {
      "additionalProperties": false,
      "description": "A safe resting place: a place where a stopped robot is *not* holding\nanother robot's zone authority.",
      "properties": {
        "capacity": {
          "default": 1,
          "maximum": 16,
          "minimum": 1,
          "title": "Capacity",
          "type": "integer"
        },
        "id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "pose": {
          "$ref": "#/$defs/Pose2"
        }
      },
      "required": [
        "id",
        "pose"
      ],
      "title": "Berth",
      "type": "object"
    },
    "Capability": {
      "enum": [
        "carry_payload",
        "tow",
        "spot_fill",
        "dock",
        "clean"
      ],
      "title": "Capability",
      "type": "string"
    },
    "ComparisonMode": {
      "enum": [
        "coordination_only",
        "end_to_end"
      ],
      "title": "ComparisonMode",
      "type": "string"
    },
    "CoordinationPolicy": {
      "description": "The two policies that must sit behind identical interfaces.",
      "enum": [
        "stop_and_wait",
        "canonical_sequential"
      ],
      "title": "CoordinationPolicy",
      "type": "string"
    },
    "FaultChannel": {
      "enum": [
        "coordination",
        "telemetry"
      ],
      "title": "FaultChannel",
      "type": "string"
    },
    "FaultKind": {
      "enum": [
        "delay",
        "loss",
        "duplicate",
        "reorder",
        "partition",
        "clock_skew",
        "obstacle_insert",
        "obstacle_remove",
        "sensor_stale",
        "sensor_dropout",
        "control_overload",
        "process_crash",
        "process_restart",
        "journal_corrupt"
      ],
      "title": "FaultKind",
      "type": "string"
    },
    "FaultParam": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ]
    },
    "FaultSpec": {
      "additionalProperties": false,
      "properties": {
        "duration_s": {
          "default": 1.0,
          "maximum": 86400.0,
          "minimum": 0.0,
          "title": "Duration S",
          "type": "number"
        },
        "expected_invariant": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Expected Invariant",
          "type": "string"
        },
        "fault_id": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Fault Id",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/FaultParam"
          },
          "title": "Params",
          "type": "object"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "default": 0,
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "start_at_s": {
          "default": 0.0,
          "maximum": 86400.0,
          "minimum": 0.0,
          "title": "Start At S",
          "type": "number"
        },
        "target": {
          "$ref": "#/$defs/FaultTarget"
        }
      },
      "required": [
        "fault_id",
        "target",
        "expected_invariant"
      ],
      "title": "FaultSpec",
      "type": "object"
    },
    "FaultTarget": {
      "additionalProperties": false,
      "description": "Explicit sender/receiver targeting. A fault with no target is invalid -\nthe brief requires directed fault injection, not a global toggle.",
      "properties": {
        "channel": {
          "$ref": "#/$defs/FaultChannel"
        },
        "kind": {
          "$ref": "#/$defs/FaultKind"
        },
        "message_kind": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message Kind"
        },
        "position": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "receiver": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receiver"
        },
        "robot": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Robot"
        },
        "sender": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sender"
        },
        "zone_id": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zone Id"
        }
      },
      "required": [
        "channel",
        "kind"
      ],
      "title": "FaultTarget",
      "type": "object"
    },
    "FeatureFlags": {
      "additionalProperties": false,
      "description": "Ablation switches. Unsafe research variants are namespaced so they can\nnever be enabled by accident in a physical deployment.",
      "properties": {
        "blocked_aware_routing": {
          "default": true,
          "title": "Blocked Aware Routing",
          "type": "boolean"
        },
        "disable_safety_gate": {
          "default": false,
          "title": "Disable Safety Gate",
          "type": "boolean"
        },
        "fairness_aware_priority": {
          "default": true,
          "title": "Fairness Aware Priority",
          "type": "boolean"
        },
        "task_reassignment": {
          "default": true,
          "title": "Task Reassignment",
          "type": "boolean"
        },
        "temporal_planning": {
          "default": false,
          "title": "Temporal Planning",
          "type": "boolean"
        },
        "timer_expiry_occupancy": {
          "default": false,
          "title": "Timer Expiry Occupancy",
          "type": "boolean"
        },
        "unsafe_flags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unsafe Flags",
          "type": "array"
        },
        "unsafe_research_variant": {
          "default": false,
          "title": "Unsafe Research Variant",
          "type": "boolean"
        }
      },
      "title": "FeatureFlags",
      "type": "object"
    },
    "Footprint": {
      "additionalProperties": false,
      "description": "Finite robot geometry, plus payload overhang when carrying.\n\n``length_m``/``width_m`` describe the chassis. ``payload_length_m`` and\n``payload_width_m`` describe the largest carried load. ``payload_offset_m``\nis the distance from the chassis centre to the payload centre along the\nchassis ``+x`` axis (positive = front overhang).",
      "properties": {
        "length_m": {
          "exclusiveMinimum": 0.0,
          "maximum": 5.0,
          "title": "Length M",
          "type": "number"
        },
        "payload_length_m": {
          "default": 0.0,
          "maximum": 5.0,
          "minimum": 0.0,
          "title": "Payload Length M",
          "type": "number"
        },
        "payload_offset_m": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Payload Offset M",
          "type": "number"
        },
        "payload_width_m": {
          "default": 0.0,
          "maximum": 5.0,
          "minimum": 0.0,
          "title": "Payload Width M",
          "type": "number"
        },
        "turning_radius_m": {
          "default": 0.35,
          "exclusiveMinimum": 0.0,
          "maximum": 5.0,
          "title": "Turning Radius M",
          "type": "number"
        },
        "width_m": {
          "exclusiveMinimum": 0.0,
          "maximum": 5.0,
          "title": "Width M",
          "type": "number"
        }
      },
      "required": [
        "length_m",
        "width_m"
      ],
      "title": "Footprint",
      "type": "object"
    },
    "IntentDescription": {
      "additionalProperties": false,
      "description": "Human-readable description of the experiment, shown in the UI.",
      "properties": {
        "expect": {
          "default": "",
          "maxLength": 400,
          "title": "Expect",
          "type": "string"
        },
        "expected_failure_reason": {
          "default": "",
          "maxLength": 200,
          "title": "Expected Failure Reason",
          "type": "string"
        },
        "goal": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        }
      },
      "required": [
        "goal"
      ],
      "title": "IntentDescription",
      "type": "object"
    },
    "MapBoundary": {
      "additionalProperties": false,
      "description": "Axis-aligned usable envelope of the warehouse, in metres.",
      "properties": {
        "max_x": {
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "Max X",
          "type": "number"
        },
        "max_y": {
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "Max Y",
          "type": "number"
        },
        "min_x": {
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "Min X",
          "type": "number"
        },
        "min_y": {
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "Min Y",
          "type": "number"
        }
      },
      "required": [
        "min_x",
        "min_y",
        "max_x",
        "max_y"
      ],
      "title": "MapBoundary",
      "type": "object"
    },
    "Obstacle": {
      "additionalProperties": false,
      "properties": {
        "dynamic": {
          "default": false,
          "title": "Dynamic",
          "type": "boolean"
        },
        "id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ObstacleKind",
          "default": "shelf"
        },
        "length_m": {
          "exclusiveMinimum": 0.0,
          "maximum": 200.0,
          "title": "Length M",
          "type": "number"
        },
        "pose": {
          "$ref": "#/$defs/Pose2"
        },
        "width_m": {
          "exclusiveMinimum": 0.0,
          "maximum": 200.0,
          "title": "Width M",
          "type": "number"
        }
      },
      "required": [
        "id",
        "pose",
        "length_m",
        "width_m"
      ],
      "title": "Obstacle",
      "type": "object"
    },
    "ObstacleKind": {
      "enum": [
        "shelf",
        "wall",
        "pillar",
        "temporary"
      ],
      "title": "ObstacleKind",
      "type": "string"
    },
    "Pose2": {
      "additionalProperties": false,
      "description": "Planar pose in metres/radians. Distinct from a *measured* pose estimate.",
      "properties": {
        "theta": {
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "Theta",
          "type": "number"
        },
        "x": {
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "theta"
      ],
      "title": "Pose2",
      "type": "object"
    },
    "ProtocolTiming": {
      "additionalProperties": false,
      "description": "All protocol deadlines live in the agent's declared time domain.",
      "properties": {
        "cancel_timeout_s": {
          "default": 1.5,
          "exclusiveMinimum": 0.01,
          "maximum": 10.0,
          "title": "Cancel Timeout S",
          "type": "number"
        },
        "control_period_s": {
          "default": 0.05,
          "exclusiveMinimum": 0.005,
          "maximum": 1.0,
          "title": "Control Period S",
          "type": "number"
        },
        "freshness_horizon_s": {
          "default": 1.0,
          "exclusiveMinimum": 0.01,
          "maximum": 10.0,
          "title": "Freshness Horizon S",
          "type": "number"
        },
        "heartbeat_period_s": {
          "default": 0.2,
          "exclusiveMinimum": 0.01,
          "maximum": 10.0,
          "title": "Heartbeat Period S",
          "type": "number"
        },
        "intent_publish_period_s": {
          "default": 0.5,
          "exclusiveMinimum": 0.01,
          "maximum": 5.0,
          "title": "Intent Publish Period S",
          "type": "number"
        },
        "intent_validity_s": {
          "default": 3.0,
          "exclusiveMinimum": 0.05,
          "maximum": 30.0,
          "title": "Intent Validity S",
          "type": "number"
        },
        "queue_tiebreak_s": {
          "default": 0.0,
          "maximum": 5.0,
          "minimum": 0.0,
          "title": "Queue Tiebreak S",
          "type": "number"
        },
        "release_timeout_s": {
          "default": 5.0,
          "exclusiveMinimum": 0.01,
          "maximum": 30.0,
          "title": "Release Timeout S",
          "type": "number"
        },
        "solicit_timeout_s": {
          "default": 0.8,
          "exclusiveMinimum": 0.01,
          "maximum": 10.0,
          "title": "Solicit Timeout S",
          "type": "number"
        },
        "state_publish_period_s": {
          "default": 0.1,
          "exclusiveMinimum": 0.01,
          "maximum": 5.0,
          "title": "State Publish Period S",
          "type": "number"
        }
      },
      "title": "ProtocolTiming",
      "type": "object"
    },
    "RobotIdentity": {
      "additionalProperties": false,
      "description": "Persistent identity of a physical robot.",
      "properties": {
        "capabilities": {
          "default": [
            "carry_payload"
          ],
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "footprint": {
          "$ref": "#/$defs/Footprint"
        },
        "max_angular_radps": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "maximum": 3.0,
          "title": "Max Angular Radps",
          "type": "number"
        },
        "max_linear_mps": {
          "default": 0.4,
          "exclusiveMinimum": 0.0,
          "maximum": 2.0,
          "title": "Max Linear Mps",
          "type": "number"
        },
        "model": {
          "default": "niharamesh-amr",
          "maxLength": 64,
          "title": "Model",
          "type": "string"
        },
        "robot_id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Robot Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "robot_id",
        "footprint"
      ],
      "title": "RobotIdentity",
      "type": "object"
    },
    "RobotStart": {
      "additionalProperties": false,
      "properties": {
        "assigned_task_id": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assigned Task Id"
        },
        "holding_task_id": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holding Task Id"
        },
        "pose": {
          "$ref": "#/$defs/Pose2"
        },
        "robot_id": {
          "maxLength": 40,
          "title": "Robot Id",
          "type": "string"
        }
      },
      "required": [
        "robot_id",
        "pose"
      ],
      "title": "RobotStart",
      "type": "object"
    },
    "RouteEdge": {
      "additionalProperties": false,
      "description": "Directed travel edge for the optional directed-route graph.\n\nWhen a map declares ``directed_routes``, the planner must respect\n``one_way`` on each edge. This is a topological *hint*, not authority.",
      "properties": {
        "cost_m": {
          "exclusiveMinimum": 0.0,
          "maximum": 1000.0,
          "title": "Cost M",
          "type": "number"
        },
        "from_pose": {
          "$ref": "#/$defs/Pose2"
        },
        "id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "one_way": {
          "default": true,
          "title": "One Way",
          "type": "boolean"
        },
        "to_pose": {
          "$ref": "#/$defs/Pose2"
        }
      },
      "required": [
        "id",
        "from_pose",
        "to_pose",
        "cost_m"
      ],
      "title": "RouteEdge",
      "type": "object"
    },
    "RoutingPolicy": {
      "enum": [
        "shortest",
        "blocked_aware",
        "temporal_sipp_approx"
      ],
      "title": "RoutingPolicy",
      "type": "string"
    },
    "RunPolicy": {
      "additionalProperties": false,
      "properties": {
        "assignment": {
          "$ref": "#/$defs/AssignmentPolicy",
          "default": "local_auction"
        },
        "comparison_mode": {
          "$ref": "#/$defs/ComparisonMode",
          "default": "coordination_only"
        },
        "coordination": {
          "$ref": "#/$defs/CoordinationPolicy",
          "default": "canonical_sequential"
        },
        "fault_seed": {
          "default": 3,
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Fault Seed",
          "type": "integer"
        },
        "planner_seed": {
          "default": 1,
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Planner Seed",
          "type": "integer"
        },
        "routing": {
          "$ref": "#/$defs/RoutingPolicy",
          "default": "blocked_aware"
        },
        "sensor_seed": {
          "default": 2,
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Sensor Seed",
          "type": "integer"
        }
      },
      "title": "RunPolicy",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "description": "The authored experiment. Validated separately (structure vs feasibility).",
      "properties": {
        "description": {
          "default": "",
          "maxLength": 400,
          "title": "Description",
          "type": "string"
        },
        "faults": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FaultSpec"
          },
          "title": "Faults",
          "type": "array"
        },
        "intent": {
          "$ref": "#/$defs/IntentDescription"
        },
        "kind": {
          "default": "nominal",
          "enum": [
            "nominal",
            "fault",
            "diagnostic",
            "benchmark"
          ],
          "title": "Kind",
          "type": "string"
        },
        "map": {
          "$ref": "#/$defs/WarehouseMap"
        },
        "max_sim_time_s": {
          "default": 900.0,
          "exclusiveMinimum": 1.0,
          "maximum": 86400.0,
          "title": "Max Sim Time S",
          "type": "number"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/RunPolicy",
          "default": {
            "assignment": "local_auction",
            "comparison_mode": "coordination_only",
            "coordination": "canonical_sequential",
            "fault_seed": 3,
            "planner_seed": 1,
            "routing": "blocked_aware",
            "sensor_seed": 2
          }
