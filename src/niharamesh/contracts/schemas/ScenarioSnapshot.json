  "$id": "https://niharamesh.local/schemas/ScenarioSnapshot.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A frozen copy handed to a launched run.\n\nContains the full scenario plus the digests that must be quoted by every\nresult derived from it. Never mutated after creation.",
  "properties": {
    "config_digest": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Config Digest",
      "type": "string"
    },
    "created_utc_ns": {
      "minimum": 0,
      "title": "Created Utc Ns",
      "type": "integer"
    },
    "fault_digest": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Fault Digest",
      "type": "string"
    },
    "map_digest": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Map Digest",
      "type": "string"
    },
    "scenario": {
      "$ref": "#/$defs/Scenario"
    },
    "scenario_digest": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Scenario Digest",
      "type": "string"
    },
    "snapshot_id": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "task_digest": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Task Digest",
      "type": "string"
    }
  },
  "required": [
    "snapshot_id",
    "created_utc_ns",
    "scenario",
    "scenario_digest",
    "map_digest",
    "config_digest",
    "fault_digest",
    "task_digest"
  ],
  "title": "ScenarioSnapshot",
  "type": "object",
  "x-niharamesh-version": "1.0.0"
}
