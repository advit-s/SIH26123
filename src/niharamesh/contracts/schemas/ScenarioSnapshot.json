              "minimum": -1000000000.0,
              "type": "number"
            },
            {
              "maximum": 1000000000.0,
              "minimum": -1000000000.0,
              "type": "number"
            }
          ],
          "title": "Protected Origin",
          "type": "array"
        },
        "queue_berth_id": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queue Berth Id"
        },
        "stop_line_in": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Line In"
