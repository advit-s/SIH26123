    "Zone": {
      "additionalProperties": false,
      "description": "An exclusive resource with disjoint protected geometry.\n\nEvery exclusive zone's protected geometry must be **disjoint** from every\nother exclusive zone's. Where a traversal needs two adjacent resources with\nno safe berth between them, they must be authored as ONE compound zone\n(see ``members``), not as two zones a robot might partially hold.",
      "properties": {
        "allowed_movement": {
          "default": [
            "forward",
            "cross"
          ],
          "items": {
            "$ref": "#/$defs/ZoneMovement"
          },
          "title": "Allowed Movement",
          "type": "array"
        },
        "description": {
          "default": "",
          "maxLength": 240,
          "title": "Description",
          "type": "string"
        },
        "entry_pose": {
          "$ref": "#/$defs/Pose2"
        },
        "exit_berth_id": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Berth Id"
        },
        "exit_pose": {
          "$ref": "#/$defs/Pose2"
        },
        "id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "corridor",
          "maxLength": 32,
          "title": "Kind",
          "type": "string"
        },
        "members": {
          "default": [],
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "title": "Members",
          "type": "array"
        },
        "one_way_heading_rad": {
          "anyOf": [
            {
              "maximum": 1000000000.0,
              "minimum": -1000000000.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "One Way Heading Rad"
        },
        "protected_extent": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 1000000000.0,
              "minimum": -1000000000.0,
              "type": "number"
            },
            {
              "maximum": 1000000000.0,
              "minimum": -1000000000.0,
              "type": "number"
            }
          ],
          "title": "Protected Extent",
          "type": "array"
        },
        "protected_origin": {
          "maxItems": 2,
