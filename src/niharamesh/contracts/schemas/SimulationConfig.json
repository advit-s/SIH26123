{
  "$defs": {
    "ActuatorModel": {
      "additionalProperties": false,
      "properties": {
        "accel_mps2": {
          "default": 0.5,
          "exclusiveMinimum": 0.0,
          "maximum": 5.0,
          "title": "Accel Mps2",
          "type": "number"
        },
        "angular_accel_radps2": {
          "default": 1.5,
          "exclusiveMinimum": 0.0,
          "maximum": 10.0,
          "title": "Angular Accel Radps2",
          "type": "number"
        },
        "command_ttl_s": {
          "default": 0.4,
          "exclusiveMinimum": 0.01,
          "maximum": 10.0,
          "title": "Command Ttl S",
          "type": "number"
        },
        "decel_mps2": {
          "default": 0.8,
          "exclusiveMinimum": 0.0,
          "maximum": 10.0,
          "title": "Decel Mps2",
          "type": "number"
        },
        "max_angular_radps": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "maximum": 3.0,
          "title": "Max Angular Radps",
          "type": "number"
        },
        "max_linear_mps": {
          "default": 0.4,
          "exclusiveMinimum": 0.0,
          "maximum": 2.0,
          "title": "Max Linear Mps",
          "type": "number"
        }
      },
      "title": "ActuatorModel",
      "type": "object"
    },
    "BatteryModel": {
      "additionalProperties": false,
      "description": "Declared battery model. UI must state ``source`` alongside any value.",
      "properties": {
        "drain_per_metre_c": {
          "default": 4e-05,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Drain Per Metre C",
          "type": "number"
        },
        "drain_per_second_idle_c": {
          "default": 8e-06,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Drain Per Second Idle C",
          "type": "number"
        },
        "service_drain_c": {
          "default": 0.0005,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Service Drain C",
          "type": "number"
        },
        "source": {
          "default": "simulated",
          "maxLength": 16,
          "title": "Source",
          "type": "string"
        },
        "start_fraction": {
          "default": 0.92,
          "maximum": 1.0,
          "minimum": 0.01,
          "title": "Start Fraction",
          "type": "number"
        }
      },
      "title": "BatteryModel",
      "type": "object"
    },
    "FeatureFlags": {
      "additionalProperties": false,
      "description": "Ablation switches. Unsafe research variants are namespaced so they can\nnever be enabled by accident in a physical deployment.",
      "properties": {
        "blocked_aware_routing": {
          "default": true,
          "title": "Blocked Aware Routing",
          "type": "boolean"
        },
        "disable_safety_gate": {
          "default": false,
          "title": "Disable Safety Gate",
          "type": "boolean"
        },
        "fairness_aware_priority": {
          "default": true,
          "title": "Fairness Aware Priority",
          "type": "boolean"
        },
        "task_reassignment": {
          "default": true,
          "title": "Task Reassignment",
          "type": "boolean"
        },
        "temporal_planning": {
          "default": false,
          "title": "Temporal Planning",
          "type": "boolean"
        },
        "timer_expiry_occupancy": {
          "default": false,
          "title": "Timer Expiry Occupancy",
          "type": "boolean"
        },
        "unsafe_flags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unsafe Flags",
          "type": "array"
        },
        "unsafe_research_variant": {
          "default": false,
          "title": "Unsafe Research Variant",
          "type": "boolean"
        }
      },
      "title": "FeatureFlags",
      "type": "object"
    },
    "ProtocolTiming": {
      "additionalProperties": false,
      "description": "All protocol deadlines live in the agent's declared time domain.",
      "properties": {
        "cancel_timeout_s": {
          "default": 1.5,
          "exclusiveMinimum": 0.01,
          "maximum": 10.0,
          "title": "Cancel Timeout S",
          "type": "number"
        },
        "control_period_s": {
          "default": 0.05,
          "exclusiveMinimum": 0.005,
          "maximum": 1.0,
          "title": "Control Period S",
          "type": "number"
        },
        "freshness_horizon_s": {
          "default": 1.0,
          "exclusiveMinimum": 0.01,
          "maximum": 10.0,
          "title": "Freshness Horizon S",
          "type": "number"
        },
        "heartbeat_period_s": {
          "default": 0.2,
          "exclusiveMinimum": 0.01,
          "maximum": 10.0,
          "title": "Heartbeat Period S",
          "type": "number"
        },
        "intent_publish_period_s": {
          "default": 0.5,
          "exclusiveMinimum": 0.01,
          "maximum": 5.0,
          "title": "Intent Publish Period S",
          "type": "number"
        },
        "intent_validity_s": {
          "default": 3.0,
          "exclusiveMinimum": 0.05,
          "maximum": 30.0,
          "title": "Intent Validity S",
          "type": "number"
        },
        "queue_tiebreak_s": {
          "default": 0.0,
          "maximum": 5.0,
          "minimum": 0.0,
          "title": "Queue Tiebreak S",
          "type": "number"
        },
        "release_timeout_s": {
          "default": 5.0,
          "exclusiveMinimum": 0.01,
          "maximum": 30.0,
          "title": "Release Timeout S",
          "type": "number"
        },
        "solicit_timeout_s": {
          "default": 0.8,
          "exclusiveMinimum": 0.01,
          "maximum": 10.0,
          "title": "Solicit Timeout S",
          "type": "number"
        },
        "state_publish_period_s": {
          "default": 0.1,
          "exclusiveMinimum": 0.01,
          "maximum": 5.0,
          "title": "State Publish Period S",
          "type": "number"
        }
      },
      "title": "ProtocolTiming",
      "type": "object"
    },
    "SensorModel": {
      "additionalProperties": false,
      "description": "Declared sensing limits and noise. Every value is a simulation\nconfiguration, labelled as such wherever it is displayed.",
      "properties": {
        "angular_resolution_rad": {
          "default": 0.0436,
          "exclusiveMinimum": 0.001,
          "maximum": 0.5,
          "title": "Angular Resolution Rad",
          "type": "number"
        },
        "dropout_probability": {
          "default": 0.02,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Dropout Probability",
          "type": "number"
        },
        "field_of_view_rad": {
          "default": 4.712,
          "exclusiveMinimum": 0.1,
          "maximum": 6.28318,
          "title": "Field Of View Rad",
          "type": "number"
        },
        "heading_sigma_rad": {
          "default": 0.01,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Heading Sigma Rad",
          "type": "number"
        },
        "observation_latency_s": {
          "default": 0.1,
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Observation Latency S",
          "type": "number"
        },
        "position_sigma_m": {
          "default": 0.02,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Position Sigma M",
          "type": "number"
        },
        "range_m": {
          "default": 3.0,
          "exclusiveMinimum": 0.1,
          "maximum": 100.0,
          "title": "Range M",
          "type": "number"
        },
        "range_noise_m": {
          "default": 0.02,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Range Noise M",
          "type": "number"
        }
      },
      "title": "SensorModel",
      "type": "object"
    },
    "StoppingBudget": {
      "additionalProperties": false,
      "description": "Derived stopping distance parameters.\n\nThese are *configured assumptions* for a low-speed simulation. They are not\ncertified real-world limits and are never presented as a safety guarantee.\n\nExample from the brief at v=0.4 m/s, t_r=0.30 s, a=0.8 m/s^2, margin=0.10 m:\nreaction 0.12 m + braking 0.10 m + margin 0.10 m = 0.32 m.",
      "properties": {
        "braking_decel_mps2": {
          "default": 0.8,
          "exclusiveMinimum": 0.0,
          "maximum": 10.0,
          "title": "Braking Decel Mps2",
          "type": "number"
        },
        "extra_margin_m": {
          "default": 0.1,
          "maximum": 5.0,
          "minimum": 0.0,
          "title": "Extra Margin M",
          "type": "number"
        },
        "max_speed_mps": {
          "default": 0.4,
          "exclusiveMinimum": 0.0,
          "maximum": 2.0,
          "title": "Max Speed Mps",
          "type": "number"
        },
        "reaction_time_s": {
          "default": 0.3,
          "maximum": 5.0,
          "minimum": 0.0,
          "title": "Reaction Time S",
          "type": "number"
        }
      },
      "title": "StoppingBudget",
      "type": "object"
    }
  },
  "$id": "https://niharamesh.local/schemas/SimulationConfig.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actuator": {
      "$ref": "#/$defs/ActuatorModel",
      "default": {
        "accel_mps2": 0.5,
        "angular_accel_radps2": 1.5,
        "command_ttl_s": 0.4,
        "decel_mps2": 0.8,
        "max_angular_radps": 1.0,
        "max_linear_mps": 0.4
      }
    },
    "battery": {
      "$ref": "#/$defs/BatteryModel",
      "default": {
        "drain_per_metre_c": 4e-05,
        "drain_per_second_idle_c": 8e-06,
        "service_drain_c": 0.0005,
        "source": "simulated",
        "start_fraction": 0.92
      }
    },
    "features": {
      "$ref": "#/$defs/FeatureFlags",
      "default": {
        "blocked_aware_routing": true,
        "disable_safety_gate": false,
        "fairness_aware_priority": true,
        "task_reassignment": true,
        "temporal_planning": false,
        "timer_expiry_occupancy": false,
        "unsafe_flags": [],
        "unsafe_research_variant": false
      }
    },
    "physical_actuation_enabled": {
      "default": false,
      "title": "Physical Actuation Enabled",
      "type": "boolean"
    },
    "physics_step_hz": {
      "default": 20,
      "maximum": 200,
      "minimum": 5,
      "title": "Physics Step Hz",
      "type": "integer"
    },
    "protocol": {
      "$ref": "#/$defs/ProtocolTiming",
      "default": {
        "cancel_timeout_s": 1.5,
        "control_period_s": 0.05,
        "freshness_horizon_s": 1.0,
        "heartbeat_period_s": 0.2,
        "intent_publish_period_s": 0.5,
        "intent_validity_s": 3.0,
        "queue_tiebreak_s": 0.0,
        "release_timeout_s": 5.0,
        "solicit_timeout_s": 0.8,
        "state_publish_period_s": 0.1
      }
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sensor": {
      "$ref": "#/$defs/SensorModel",
      "default": {
        "angular_resolution_rad": 0.0436,
        "dropout_probability": 0.02,
        "field_of_view_rad": 4.712,
        "heading_sigma_rad": 0.01,
        "observation_latency_s": 0.1,
        "position_sigma_m": 0.02,
        "range_m": 3.0,
        "range_noise_m": 0.02
      }
    },
    "simulated_actuation_enabled": {
      "default": true,
      "title": "Simulated Actuation Enabled",
      "type": "boolean"
    },
    "state_publish_hz": {
      "default": 10,
      "maximum": 60,
      "minimum": 1,
      "title": "State Publish Hz",
      "type": "integer"
    },
    "stopping": {
      "$ref": "#/$defs/StoppingBudget",
      "default": {
        "braking_decel_mps2": 0.8,
        "extra_margin_m": 0.1,
        "max_speed_mps": 0.4,
        "reaction_time_s": 0.3
      }
    }
  },
  "title": "SimulationConfig",
  "type": "object",
  "x-niharamesh-version": "1.0.0"
}
