{
  "$id": "https://niharamesh.local/schemas/TaskAward.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Announcement of the outcome of one allocation round.\n\nAwarding is deterministic given the same bid set: lowest ``total_cost``\namong feasible bids, ties broken by ``tie_break`` then ``robot_id``. A robot\ncomputes this locally from received bids; no backend picks winners.",
  "properties": {
    "announced_by": {
      "default": "",
      "maxLength": 40,
      "minLength": 1,
      "title": "Announced By",
      "type": "string"
    },
    "at_ns": {
      "minimum": 0,
      "title": "At Ns",
      "type": "integer"
    },
    "bid_set_digest": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Bid Set Digest",
      "type": "string"
    },
    "epoch": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Epoch",
      "type": "string"
    },
    "explicit_no_bid": {
      "default": false,
      "title": "Explicit No Bid",
      "type": "boolean"
    },
    "ownership_version": {
      "minimum": 1,
      "title": "Ownership Version",
      "type": "integer"
    },
    "round_id": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Round Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "winner": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Winner",
      "type": "string"
    },
    "winner_session": {
      "maxLength": 40,
      "title": "Winner Session",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "epoch",
    "task_id",
    "round_id",
    "winner",
    "winner_session",
    "ownership_version",
    "bid_set_digest",
    "at_ns"
  ],
  "title": "TaskAward",
  "type": "object",
  "x-niharamesh-version": "1.0.0"
}
