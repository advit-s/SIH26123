{
  "$defs": {
    "Berth": {
      "additionalProperties": false,
      "description": "A safe resting place: a place where a stopped robot is *not* holding\nanother robot's zone authority.",
      "properties": {
        "capacity": {
          "default": 1,
          "maximum": 16,
          "minimum": 1,
          "title": "Capacity",
          "type": "integer"
        },
        "id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "pose": {
          "$ref": "#/$defs/Pose2"
        }
      },
      "required": [
        "id",
        "pose"
      ],
      "title": "Berth",
      "type": "object"
    },
    "MapBoundary": {
      "additionalProperties": false,
      "description": "Axis-aligned usable envelope of the warehouse, in metres.",
      "properties": {
        "max_x": {
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "Max X",
          "type": "number"
        },
        "max_y": {
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "Max Y",
          "type": "number"
        },
        "min_x": {
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "Min X",
          "type": "number"
        },
        "min_y": {
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "Min Y",
          "type": "number"
        }
      },
      "required": [
        "min_x",
        "min_y",
        "max_x",
        "max_y"
      ],
      "title": "MapBoundary",
      "type": "object"
    },
    "Obstacle": {
      "additionalProperties": false,
      "properties": {
        "dynamic": {
          "default": false,
          "title": "Dynamic",
          "type": "boolean"
        },
        "id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ObstacleKind",
          "default": "shelf"
        },
        "length_m": {
          "exclusiveMinimum": 0.0,
          "maximum": 200.0,
          "title": "Length M",
          "type": "number"
        },
        "pose": {
          "$ref": "#/$defs/Pose2"
        },
        "width_m": {
          "exclusiveMinimum": 0.0,
          "maximum": 200.0,
          "title": "Width M",
          "type": "number"
        }
      },
      "required": [
        "id",
        "pose",
        "length_m",
        "width_m"
      ],
      "title": "Obstacle",
      "type": "object"
    },
    "ObstacleKind": {
      "enum": [
        "shelf",
        "wall",
        "pillar",
        "temporary"
      ],
      "title": "ObstacleKind",
      "type": "string"
    },
    "Pose2": {
      "additionalProperties": false,
      "description": "Planar pose in metres/radians. Distinct from a *measured* pose estimate.",
      "properties": {
        "theta": {
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "Theta",
          "type": "number"
        },
        "x": {
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1000000000.0,
          "minimum": -1000000000.0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "theta"
      ],
      "title": "Pose2",
      "type": "object"
    },
    "RouteEdge": {
      "additionalProperties": false,
      "description": "Directed travel edge for the optional directed-route graph.\n\nWhen a map declares ``directed_routes``, the planner must respect\n``one_way`` on each edge. This is a topological *hint*, not authority.",
      "properties": {
        "cost_m": {
          "exclusiveMinimum": 0.0,
          "maximum": 1000.0,
          "title": "Cost M",
          "type": "number"
        },
        "from_pose": {
          "$ref": "#/$defs/Pose2"
        },
        "id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "one_way": {
          "default": true,
          "title": "One Way",
          "type": "boolean"
        },
        "to_pose": {
          "$ref": "#/$defs/Pose2"
        }
      },
      "required": [
        "id",
        "from_pose",
        "to_pose",
        "cost_m"
      ],
      "title": "RouteEdge",
      "type": "object"
    },
    "Station": {
      "additionalProperties": false,
      "properties": {
        "capacity": {
          "default": 1,
          "maximum": 64,
          "minimum": 1,
          "title": "Capacity",
          "type": "integer"
        },
        "id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/StationKind"
        },
        "pose": {
          "$ref": "#/$defs/Pose2"
        },
        "service_time_s": {
          "default": 4.0,
          "maximum": 600.0,
          "minimum": 0.0,
          "title": "Service Time S",
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind",
        "pose"
      ],
      "title": "Station",
      "type": "object"
    },
    "StationKind": {
      "enum": [
        "pickup",
        "drop",
        "charge"
      ],
      "title": "StationKind",
      "type": "string"
    },
    "StopLine": {
      "additionalProperties": false,
      "description": "Physical line a robot must not cross without the named authority.\n\n``zone_id`` names the authority required. This is the geometric anchor for\n\"stop-line violation\", which the evaluator checks independently.",
      "properties": {
        "approach": {
          "default": "decreasing",
          "pattern": "^(increasing|decreasing)$",
          "title": "Approach",
          "type": "string"
        },
        "end": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 1000000000.0,
              "minimum": -1000000000.0,
              "type": "number"
            },
            {
              "maximum": 1000000000.0,
              "minimum": -1000000000.0,
              "type": "number"
            }
          ],
          "title": "End",
          "type": "array"
        },
        "id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "start": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 1000000000.0,
              "minimum": -1000000000.0,
              "type": "number"
            },
            {
              "maximum": 1000000000.0,
              "minimum": -1000000000.0,
              "type": "number"
            }
          ],
          "title": "Start",
          "type": "array"
        },
        "zone_id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Zone Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "zone_id",
        "start",
        "end"
      ],
      "title": "StopLine",
      "type": "object"
    },
    "Zone": {
      "additionalProperties": false,
      "description": "An exclusive resource with disjoint protected geometry.\n\nEvery exclusive zone's protected geometry must be **disjoint** from every\nother exclusive zone's. Where a traversal needs two adjacent resources with\nno safe berth between them, they must be authored as ONE compound zone\n(see ``members``), not as two zones a robot might partially hold.",
      "properties": {
        "allowed_movement": {
          "default": [
            "forward",
            "cross"
          ],
          "items": {
            "$ref": "#/$defs/ZoneMovement"
          },
          "title": "Allowed Movement",
          "type": "array"
        },
        "description": {
          "default": "",
          "maxLength": 240,
          "title": "Description",
          "type": "string"
        },
        "entry_pose": {
          "$ref": "#/$defs/Pose2"
        },
        "exit_berth_id": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Berth Id"
        },
        "exit_pose": {
          "$ref": "#/$defs/Pose2"
        },
        "id": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "corridor",
          "maxLength": 32,
          "title": "Kind",
          "type": "string"
        },
        "members": {
          "default": [],
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "title": "Members",
          "type": "array"
        },
        "one_way_heading_rad": {
          "anyOf": [
            {
              "maximum": 1000000000.0,
              "minimum": -1000000000.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "One Way Heading Rad"
        },
        "protected_extent": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 1000000000.0,
              "minimum": -1000000000.0,
              "type": "number"
            },
            {
              "maximum": 1000000000.0,
              "minimum": -1000000000.0,
              "type": "number"
            }
          ],
          "title": "Protected Extent",
          "type": "array"
        },
        "protected_origin": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 1000000000.0,
              "minimum": -1000000000.0,
              "type": "number"
            },
            {
              "maximum": 1000000000.0,
              "minimum": -1000000000.0,
              "type": "number"
            }
          ],
          "title": "Protected Origin",
          "type": "array"
        },
        "queue_berth_id": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queue Berth Id"
        },
        "stop_line_in": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Line In"
        },
        "stop_line_out": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Line Out"
        }
      },
      "required": [
        "id",
        "protected_origin",
        "protected_extent",
        "entry_pose",
        "exit_pose"
      ],
      "title": "Zone",
      "type": "object"
    },
    "ZoneMovement": {
      "description": "The protected movement a zone authorises.\n\n``FWD``  - traverse along the zone's declared axis, either direction.\n``REV``  - traverse against the declared axis (used for one-way aisles).\n``CROSS``- cross the zone (intersections / junctions).",
      "enum": [
        "forward",
        "reverse",
        "cross"
      ],
      "title": "ZoneMovement",
      "type": "string"
    }
  },
  "$id": "https://niharamesh.local/schemas/WarehouseMap.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable shared map. Every agent receives exactly this object.",
  "properties": {
    "berths": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Berth"
      },
      "title": "Berths",
      "type": "array"
    },
    "boundary": {
      "$ref": "#/$defs/MapBoundary"
    },
    "directed_routes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RouteEdge"
      },
      "title": "Directed Routes",
      "type": "array"
    },
    "grid_resolution_m": {
      "default": 0.1,
      "exclusiveMinimum": 0.02,
      "maximum": 0.5,
      "title": "Grid Resolution M",
      "type": "number"
    },
    "map_id": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Map Id",
      "type": "string"
    },
    "name": {
      "default": "",
      "maxLength": 120,
      "title": "Name",
      "type": "string"
    },
    "nominal_aisle_width_m": {
      "default": 1.4,
      "exclusiveMinimum": 0.3,
      "maximum": 20.0,
      "title": "Nominal Aisle Width M",
      "type": "number"
    },
    "obstacles": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Obstacle"
      },
      "title": "Obstacles",
      "type": "array"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Station"
      },
      "title": "Stations",
      "type": "array"
    },
    "stop_lines": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StopLine"
      },
      "title": "Stop Lines",
      "type": "array"
    },
    "zones": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Zone"
      },
      "title": "Zones",
      "type": "array"
    }
  },
  "required": [
    "map_id",
    "boundary"
  ],
  "title": "WarehouseMap",
  "type": "object",
  "x-niharamesh-version": "1.0.0"
}
