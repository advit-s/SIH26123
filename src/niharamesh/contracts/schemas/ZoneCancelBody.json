{
  "$defs": {
    "TimeDomain": {
      "description": "Named clock domains. Values are never mixed across domains.\n\n``LOGICAL``\n    Injected logical simulation time. Freezes when the harness pauses and\n    advances under acceleration. Used by the deterministic mode.\n``SIM_SECONDS``\n    Simulation seconds elapsed since the declared common run start. Derived\n    from ``LOGICAL``; identical semantics, different unit framing.\n``MONOTONIC``\n    The agent's own ``time.monotonic_ns()``. Never comparable across\n    processes without an explicit measured offset *and* uncertainty.\n``DISPLAY_UTC``\n    Wall-clock UTC for human display only. Never used for expiry.",
      "enum": [
        "logical",
        "sim_seconds",
        "monotonic",
        "display_utc"
      ],
      "title": "TimeDomain",
      "type": "string"
    }
  },
  "$id": "https://niharamesh.local/schemas/ZoneCancelBody.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Owner-initiated, durable cancellation.\n\nSent only *after* the owner has persisted ``non_executable = true``. The\n``cancel_seq`` makes cancellation idempotent and makes late grants\nidentifiable.",
  "properties": {
    "cancel_seq": {
      "minimum": 1,
      "title": "Cancel Seq",
      "type": "integer"
    },
    "durably_non_executable": {
      "title": "Durably Non Executable",
      "type": "boolean"
    },
    "epoch": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Epoch",
      "type": "string"
    },
    "grant_id": {
      "maxLength": 24,
      "title": "Grant Id",
      "type": "string"
    },
    "protocol_version": {
      "default": "1.0.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "reason": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "request_version": {
      "minimum": 1,
      "title": "Request Version",
      "type": "integer"
    },
    "requester": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Requester",
      "type": "string"
    },
    "requester_session": {
      "maxLength": 40,
      "title": "Requester Session",
      "type": "string"
    },
    "run_id": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "time_domain": {
      "$ref": "#/$defs/TimeDomain"
    },
    "zone_id": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Zone Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "epoch",
    "zone_id",
    "requester",
    "requester_session",
    "request_version",
    "grant_id",
    "cancel_seq",
    "durably_non_executable",
    "reason",
    "time_domain"
  ],
  "title": "ZoneCancelBody",
  "type": "object",
  "x-niharamesh-version": "1.0.0"
}
