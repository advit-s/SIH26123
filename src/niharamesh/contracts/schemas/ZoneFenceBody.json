{
  "$id": "https://niharamesh.local/schemas/ZoneFenceBody.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Supervised, explicit fencing of a zone whose holder failed.\n\nThere is deliberately no \"force release\" message. Fencing makes the zone\nunavailable and is logged as an explicit, operator-visible state change.",
  "properties": {
    "epoch": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Epoch",
      "type": "string"
    },
    "fenced_by": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Fenced By",
      "type": "string"
    },
    "operator_authorised": {
      "default": false,
      "title": "Operator Authorised",
      "type": "boolean"
    },
    "previous_holder": {
      "anyOf": [
        {
          "maxLength": 40,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Holder"
    },
    "previous_requester_session": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Requester Session"
    },
    "reason": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "run_id": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "zone_id": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Zone Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "epoch",
    "zone_id",
    "fenced_by",
    "reason"
  ],
  "title": "ZoneFenceBody",
  "type": "object",
  "x-niharamesh-version": "1.0.0"
}
