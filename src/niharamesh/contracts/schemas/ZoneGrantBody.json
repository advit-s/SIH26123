{
  "$id": "https://niharamesh.local/schemas/ZoneGrantBody.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A durable promise. The voter has persisted this before sending it.",
  "properties": {
    "epoch": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Epoch",
      "type": "string"
    },
    "grant_id": {
      "maxLength": 24,
      "title": "Grant Id",
      "type": "string"
    },
    "is_self_voter": {
      "default": false,
      "title": "Is Self Voter",
      "type": "boolean"
    },
    "persistence_record_id": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Persistence Record Id",
      "type": "string"
    },
    "protocol_version": {
      "default": "1.0.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "request_version": {
      "minimum": 1,
      "title": "Request Version",
      "type": "integer"
    },
    "requester": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Requester",
      "type": "string"
    },
    "requester_session": {
      "maxLength": 40,
      "title": "Requester Session",
      "type": "string"
    },
    "required_set_digest": {
      "maxLength": 64,
      "title": "Required Set Digest",
      "type": "string"
    },
    "run_id": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "zone_id": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Zone Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "epoch",
    "zone_id",
    "requester",
    "requester_session",
    "request_version",
    "grant_id",
    "required_set_digest",
    "persistence_record_id"
  ],
  "title": "ZoneGrantBody",
  "type": "object",
  "x-niharamesh-version": "1.0.0"
}
