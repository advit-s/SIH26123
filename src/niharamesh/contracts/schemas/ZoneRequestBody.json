{
  "$defs": {
    "TimeDomain": {
      "description": "Named clock domains. Values are never mixed across domains.\n\n``LOGICAL``\n    Injected logical simulation time. Freezes when the harness pauses and\n    advances under acceleration. Used by the deterministic mode.\n``SIM_SECONDS``\n    Simulation seconds elapsed since the declared common run start. Derived\n    from ``LOGICAL``; identical semantics, different unit framing.\n``MONOTONIC``\n    The agent's own ``time.monotonic_ns()``. Never comparable across\n    processes without an explicit measured offset *and* uncertainty.\n``DISPLAY_UTC``\n    Wall-clock UTC for human display only. Never used for expiry.",
      "enum": [
        "logical",
        "sim_seconds",
        "monotonic",
        "display_utc"
      ],
      "title": "TimeDomain",
      "type": "string"
    }
  },
  "$id": "https://niharamesh.local/schemas/ZoneRequestBody.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Request to acquire ``zone_id`` for protected movement ``movement``.",
  "properties": {
    "entry_pose": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Entry Pose",
      "type": "array"
    },
    "epoch": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Epoch",
      "type": "string"
    },
    "exit_pose": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Exit Pose",
      "type": "array"
    },
    "expires_at_ns": {
      "minimum": 0,
      "title": "Expires At Ns",
      "type": "integer"
    },
    "membership_digest": {
      "maxLength": 64,
      "title": "Membership Digest",
      "type": "string"
    },
    "movement": {
      "maxLength": 24,
      "minLength": 1,
      "title": "Movement",
      "type": "string"
    },
    "protocol_version": {
      "default": "1.0.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "request_version": {
      "minimum": 1,
      "title": "Request Version",
      "type": "integer"
    },
    "requester": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Requester",
      "type": "string"
    },
    "requester_session": {
      "maxLength": 40,
      "title": "Requester Session",
      "type": "string"
    },
    "run_id": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "time_domain": {
      "$ref": "#/$defs/TimeDomain"
    },
    "zone_id": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Zone Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "epoch",
    "zone_id",
    "requester",
    "requester_session",
    "request_version",
    "movement",
    "entry_pose",
    "exit_pose",
    "expires_at_ns",
    "time_domain",
    "membership_digest"
  ],
  "title": "ZoneRequestBody",
  "type": "object",
  "x-niharamesh-version": "1.0.0"
}
